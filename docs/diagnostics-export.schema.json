{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tagverity/diagnostics.schema.json",
  "title": "TagVerity diagnostics export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "app",
    "appVersion",
    "exportedAt",
    "supportStatus",
    "isScanning",
    "historyCount",
    "batchCount",
    "privacySettingsRecoveryRequired",
    "settings",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "app": {
      "type": "string"
    },
    "appVersion": {
      "type": "string"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "supportStatus": {
      "enum": [
        "enabled",
        "disabled",
        "unsupported",
        "unknown"
      ]
    },
    "isScanning": {
      "type": "boolean"
    },
    "historyCount": {
      "type": "integer",
      "minimum": 0
    },
    "batchCount": {
      "type": "integer",
      "minimum": 0
    },
    "privacySettingsRecoveryRequired": {
      "type": "boolean"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readNdef",
        "saveRawUidInHistory",
        "saveNdefInHistory",
        "saveTechnicalIdentifiersInHistory"
      ],
      "properties": {
        "readNdef": {
          "type": "boolean"
        },
        "saveRawUidInHistory": {
          "type": "boolean"
        },
        "saveNdefInHistory": {
          "type": "boolean"
        },
        "saveTechnicalIdentifiersInHistory": {
          "type": "boolean"
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "level",
        "code",
        "message",
        "data"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "level": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string",
          "maxLength": 500
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "data": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "type": "string",
            "maxLength": 500
          },
          "additionalProperties": {
            "$ref": "#/$defs/diagnosticValue0"
          }
        }
      }
    },
    "diagnosticLeaf": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnosticValue0": {
      "anyOf": [
        {
          "$ref": "#/$defs/diagnosticLeaf"
        },
        {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "type": "string",
            "maxLength": 500
          },
          "additionalProperties": {
            "$ref": "#/$defs/diagnosticValue1"
          }
        },
        {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/diagnosticValue1"
          }
        }
      ]
    },
    "diagnosticValue1": {
      "anyOf": [
        {
          "$ref": "#/$defs/diagnosticLeaf"
        },
        {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "type": "string",
            "maxLength": 500
          },
          "additionalProperties": {
            "$ref": "#/$defs/diagnosticValue2"
          }
        },
        {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/diagnosticValue2"
          }
        }
      ]
    },
    "diagnosticValue2": {
      "anyOf": [
        {
          "$ref": "#/$defs/diagnosticLeaf"
        },
        {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "type": "string",
            "maxLength": 500
          },
          "additionalProperties": {
            "$ref": "#/$defs/diagnosticValue3"
          }
        },
        {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/diagnosticValue3"
          }
        }
      ]
    },
    "diagnosticValue3": {
      "anyOf": [
        {
          "$ref": "#/$defs/diagnosticLeaf"
        },
        {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "type": "string",
            "maxLength": 500
          },
          "additionalProperties": {
            "$ref": "#/$defs/diagnosticValue4"
          }
        },
        {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/diagnosticValue4"
          }
        }
      ]
    },
    "diagnosticValue4": {
      "$ref": "#/$defs/diagnosticLeaf"
    }
  }
}
